# Configurazione SMTP Infomaniak (Porta 587 con STARTTLS come da script)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USERNAME=antoniomichelotti@devnet-microsystems.com
SMTP_PASSWORD=INSERISCI_QUI_LA_TUA_PASSWORD_DELLA_MAIL

# Identità del Mago
OUTREACH_FROM_NAME="Antonio Michelotti"
OUTREACH_FROM_EMAIL=antoniomichelotti@devnet-microsystems.com
OUTREACH_REPLY_TO=antoniomichelotti@devnet-microsystems.com
OUTREACH_UNSUBSCRIBE_ADDRESS=antoniomichelotti@devnet-microsystems.com
OUTREACH_COMPANY_NAME="DEV-NET Microsystems"
OUTREACH_COMPANY_WEBSITE=https://devnet-microsystems.com/

# Sending pace settings (default: 10 minutes between emails, max 20 per day)
OUTREACH_DAILY_LIMIT=20
OUTREACH_MIN_DELAY_SECONDS=600
OUTREACH_MAX_DELAY_SECONDS=600